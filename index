<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Guia completo de um contrato de compra e venda de imóvel</title>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#eef1f8;--fg:#10224a;--mut:#4b5a7d;--sheet:#fff;--tip:#eaf1fd;--b:#003b8e;--o:#ff4b3a;--o2:#ff8a3d;--g1:#2b3a9a;--g2:#d13e63;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b1226;--fg:#e8edfb;--mut:#a5b2d4;--sheet:#16204a;--tip:#1f2c62}}
:root[data-theme="dark"]{--bg:#0b1226;--fg:#e8edfb;--mut:#a5b2d4;--sheet:#16204a;--tip:#1f2c62}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--fg);font-family:'Open Sans',system-ui,sans-serif;line-height:1.5}
button{font:inherit;cursor:pointer}
header,.wrap,footer{max-width:1100px;margin:0 auto;padding:0 16px}
header{padding-top:28px;padding-bottom:20px}
header small{font-weight:800;color:var(--b)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]) header small{color:#8fb4ff}}
h1{font-size:clamp(1.5rem,4.5vw,2.4rem);line-height:1.15;margin:.3rem 0 .6rem;font-weight:800}
header p{margin:0;max-width:60ch;color:var(--mut)}
.wrap{display:grid;gap:26px;padding-bottom:30px}
.pg{cursor:zoom-in;transition:transform .2s}
.pg:hover,.pg:focus-visible{transform:translateY(-3px)}
.pg .fit{border-radius:14px;overflow:hidden;box-shadow:0 10px 30px rgba(10,20,60,.25)}
.pg [data-k]{pointer-events:none}
.cap{margin:10px 2px 0;font-weight:600;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.cap span{color:var(--mut);font-weight:400}
footer{padding-bottom:40px;color:var(--mut);font-size:.85rem}
/* folder */
.fit{container-type:inline-size;width:100%}
.page{aspect-ratio:1316/897;font-size:1.25cqw;color:var(--b);background:#fff;position:relative;overflow:hidden}
.p1{display:grid;grid-template-columns:1fr 1fr 1fr}
.p1>div{border-top:6.5cqw solid #003b8e;border-bottom:6.5cqw solid #003b8e;min-height:0}
.c1{background:#fff;padding:2.4cqw 2cqw;display:flex;flex-direction:column;gap:1.6cqw}
.pill{background:linear-gradient(90deg,var(--o),var(--o2));color:#fff;font-weight:800;text-align:center;border-radius:99px;padding:1.2cqw;font-size:1.8cqw}
.g9{flex:1;display:grid;grid-template-columns:1fr 1fr;gap:.6cqw;border:.3cqw dotted var(--o);border-radius:2cqw;padding:1cqw;align-content:space-around}
.g9 .it:last-child{grid-column:1/-1}
.it,.m{position:relative;border:0;color:inherit}
.it{background:none;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.2cqw;border-radius:1cqw;padding:.5cqw;font-size:1.1cqw;transition:background .15s}
.it:hover,.it:focus-visible{background:#e8effb}
.it i{font-style:normal;font-size:2.8cqw;line-height:1}
.it::after,.m::after{content:"+";position:absolute;top:.3cqw;right:.3cqw;width:1.7cqw;height:1.7cqw;border-radius:50%;background:var(--o);color:#fff;font-weight:800;font-size:1.3cqw;line-height:1.7cqw;text-align:center}
.c2{background:linear-gradient(180deg,var(--g1),var(--g2));display:grid;place-items:center;color:#fff;text-align:center}
.logo b{font-size:8cqw;font-weight:800;line-height:1;display:flex;align-items:center;gap:.8cqw}
.logo b span{background:linear-gradient(#1d5fb8 60%,#e0303f 60%);font-size:4cqw;width:5.2cqw;height:5.2cqw;display:grid;place-items:center;border-radius:.6cqw}
.logo small{display:block;font-size:2.2cqw;font-weight:600;letter-spacing:.05em}
.c3{background:linear-gradient(180deg,#123f8c,#232c78 55%,#8a2f66);color:#fff;display:flex;flex-direction:column;justify-content:flex-end;padding:0 3cqw 6cqw;gap:.3cqw;font-size:2.2cqw}
.c3 em{font-style:normal;font-weight:400;letter-spacing:.04em}
.c3 .hl{background:linear-gradient(90deg,var(--o),var(--o2));border-radius:99px;padding:0 .8cqw;margin-right:.3cqw}
.c3 strong{font-size:3cqw;line-height:1.15;font-weight:800;margin-top:1cqw}
.p2{padding:8.5cqw 2.4cqw;display:grid;grid-template-columns:repeat(3,1fr);gap:1.4cqw;align-content:center}
.p2::before,.p2::after{content:"";position:absolute;left:0;right:0;height:6.5cqw;background:#003b8e}
.p2::before{top:0}.p2::after{bottom:0}
.m{text-align:left;border-radius:2cqw;padding:1.5cqw;display:flex;flex-direction:column;gap:.5cqw;color:#10224a;font-size:1.3cqw;transition:transform .15s}
.m:hover,.m:focus-visible{transform:scale(1.02)}
.m h3{margin:0;font-size:1.9cqw;display:flex;align-items:center;gap:.8cqw;color:var(--nc)}
.m h3 b{background:var(--nc);color:#fff;border-radius:50%;width:3cqw;height:3cqw;display:grid;place-items:center;font-size:1.8cqw;flex:none}
.m p{margin:0}.m ul{margin:0;padding-left:1.6cqw}
.m1{background:#e3f0fb;--nc:#0e6fb8}.m2{background:#fde8e8;--nc:#c93a44}.m3{background:#e2f4ea;--nc:#22794f}.m4{background:#e4eeff;--nc:#1f5fbf}.m5{background:#ece8fb;--nc:#5b48c4}
.end{border-radius:2cqw;background:linear-gradient(135deg,var(--g1),var(--g2));color:#fff;padding:1.6cqw;font-size:1.5cqw;display:flex;flex-direction:column;justify-content:center;gap:1cqw}
.end p{margin:0}
/* imagens (só aparecem se você preencher o bloco IMG no script) */
.logoimg{width:58%;height:auto}
.it img{width:4.6cqw;height:4.6cqw;object-fit:contain}
.ph{flex:none;height:24cqw;margin:0 -3cqw auto}
.m.has>p,.m.has>ul{max-width:62%}
.m>img{position:absolute;right:1.2cqw;bottom:1.2cqw;width:11cqw;height:11cqw;object-fit:contain}
/* zoom */
#ov{position:fixed;inset:0;z-index:9;background:rgba(6,12,34,.9);display:flex;flex-direction:column;padding-top:env(safe-area-inset-top,0px)}
#ov[hidden],#sh[hidden]{display:none}
.bar{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 12px;color:#dbe4ff;font-size:.9rem}
.bar div{display:flex;gap:6px}
.bar button{background:#ffffff1f;color:#fff;border:0;border-radius:99px;padding:6px 14px}
.bar button:hover{background:#ffffff40}
.stage{flex:1;display:flex;overflow:auto;padding:8px}
.stage .fit{margin:auto;flex:none;width:max(760px,min(96vw,calc((100vh - 130px)*1.467)));border-radius:12px;overflow:hidden;animation:zin .3s ease-out}
.stage [data-k]{cursor:pointer}
@keyframes zin{from{transform:scale(.6);opacity:0}}
@keyframes up{from{transform:translateY(40px);opacity:0}}
#sh{position:absolute;left:0;right:0;bottom:0;max-width:680px;margin:0 auto;max-height:65vh;overflow:auto;background:var(--sheet);color:var(--fg);border-radius:18px 18px 0 0;padding:18px 22px calc(20px + env(safe-area-inset-bottom,0px));box-shadow:0 -10px 40px rgba(0,0,0,.4);animation:up .25s ease-out}
#sh h2{margin:0 0 6px;font-size:1.3rem;display:flex;justify-content:space-between;gap:10px}
#sh h2 button{background:none;border:0;color:var(--mut);font-size:1.2rem}
#sh p{margin:.3rem 0}
#sh ul{margin:.4rem 0;padding-left:1.2rem}
.tip{background:var(--tip);border-left:4px solid var(--o);padding:9px 12px;border-radius:8px;margin-top:10px;font-size:.92rem}
:focus-visible{outline:3px solid var(--o2);outline-offset:2px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<header>
<small>UCS Farroupilha</small>
<h1>Guia completo de um contrato de compra e venda de imóvel</h1>
<p>Toque em uma página do folder para ampliar. Dentro dela, os itens marcados com + abrem mais informações.</p>
</header>
<main class="wrap">
<div class="pg" data-i="0" role="button" tabindex="0" aria-label="Ampliar página 1"><div class="fit"><div class="page p1" id="p1"></div></div><p class="cap">Página 1: capa e o que não pode faltar <span>Toque para ampliar</span></p></div>
<div class="pg" data-i="1" role="button" tabindex="0" aria-label="Ampliar página 2"><div class="fit"><div class="page p2" id="p2"></div></div><p class="cap">Página 2: os cinco módulos do contrato <span>Toque para ampliar</span></p></div>
</main>
<footer>Material informativo e educativo. Não substitui a orientação de um advogado para o seu caso.</footer>

<div id="ov" hidden>
<div class="bar"><span id="hint">Toque nos itens com + para ver mais</span><div><button id="pv" aria-label="Página anterior">‹</button><button id="nx" aria-label="Próxima página">›</button><button id="cl">Fechar ✕</button></div></div>
<div class="stage" id="st"></div>
<aside id="sh" hidden role="dialog" aria-live="polite"></aside>
</div>

<script>
const D={
a1:{i:'👤',t:'Identificação das partes',p:'Comprador e vendedor precisam estar plenamente identificados para o contrato ter validade e segurança.',l:['Nome completo, CPF/CNPJ e RG','Estado civil e regime de bens','Profissão, endereço e contatos','Representantes legais ou procuradores, se houver'],d:'Se o vendedor for casado (salvo separação absoluta de bens), o cônjuge normalmente precisa consentir com a venda (art. 1.647 do Código Civil).'},
a2:{i:'🏠',t:'Descrição do imóvel',p:'O imóvel deve ser individualizado sem margem para dúvida.',l:['Endereço completo e inscrição municipal (IPTU)','Número da matrícula e cartório de registro','Área do terreno e área construída','Confrontações e benfeitorias'],d:'Peça a certidão de matrícula atualizada: ela mostra quem é o proprietário e eventuais ônus, como hipoteca, penhora ou usufruto.'},
a3:{i:'🤝',t:'Valor da negociação',p:'O preço deve ser claro e coincidir com o que será declarado na escritura.',l:['Valor total em números e por extenso','O que está incluso (móveis, benfeitorias)','Valor do sinal e do saldo'],d:'O valor declarado influencia a base de cálculo de impostos como o ITBI. Divergências podem gerar problemas fiscais.'},
a4:{i:'💳',t:'Forma e prazo de pagamento',p:'Defina como e quando cada valor será pago.',l:['À vista, parcelado ou financiado','Datas de cada parcela e conta para depósito','Índice de correção e juros, se houver','Recibo ou termo de quitação ao final'],d:'Em caso de financiamento, inclua o prazo para aprovação do crédito e o que acontece se ele for negado.'},
a5:{i:'🔑',t:'Data de entrega e posse',p:'Estabeleça quando o comprador recebe as chaves e assume o imóvel.',l:['Data da entrega das chaves','Estado do imóvel na entrega (vistoria)','Contas de água, luz, gás e condomínio até a posse','Desocupação, se o imóvel estiver ocupado'],d:'Faça uma vistoria e registre o estado do imóvel em documento assinado pelas duas partes.'},
a6:{i:'🧾',t:'Responsabilidade por impostos, taxas e despesas',p:'Deixe escrito quem paga cada custo, para evitar conflitos depois.',l:['ITBI (em regra, pago pelo comprador)','IPTU e condomínio até a data da posse','Escritura, registro e certidões','Comissão de corretagem, se houver'],d:'Débitos de IPTU e condomínio acompanham o imóvel. Confirme a quitação antes de pagar.'},
a7:{i:'⚖️',t:'Multas e consequências do descumprimento',p:'O contrato precisa prever o que acontece se uma parte não cumprir o combinado.',l:['Multa por atraso e por desistência','Juros de mora e correção monetária','Quem arca com custas e honorários em uma eventual ação'],d:'A multa (cláusula penal) não pode ser maior do que o valor da obrigação principal (art. 412 do Código Civil).'},
a8:{i:'📑',t:'Condições para rescisão',p:'Explique em que situações o negócio pode ser desfeito e como.',l:['Hipóteses de desfazimento (inadimplemento, distrato)','Prazo e forma de notificação','Devolução de valores e eventuais retenções','Destino das benfeitorias'],d:'Em incorporações e loteamentos, a Lei 13.786/2018 traz regras específicas para o distrato.'},
a9:{i:'✍️',t:'Assinatura das partes e testemunhas',p:'A assinatura formaliza o acordo e reforça sua força como prova.',l:['Assinatura de comprador e vendedor (e cônjuges)','Duas testemunhas, quando cabível','Reconhecimento de firma ou assinatura eletrônica','Escritura pública e registro na matrícula'],d:'Para imóveis acima de 30 salários mínimos, a escritura pública é exigida (art. 108 do CC), e a propriedade só se transfere com o registro no cartório (art. 1.245 do CC).'},
m1:{i:'📋',t:'Cláusulas essenciais',p:'Sem estes itens, o contrato fica vulnerável a disputas.',l:['Identificação das partes (comprador e vendedor)','Identificação do imóvel (endereço, matrícula etc.)','Preço do imóvel','Forma de pagamento','Prazos para a quitação e entrega do imóvel'],d:'Use os itens da página 1 como checklist antes de assinar.'},
m2:{i:'⚠️',t:'Multas e inadimplemento',p:'É fundamental prever no contrato as penalidades e consequências em caso de descumprimento.',l:['Juros de mora','Multa (cláusula penal)','Rescisão contratual'],d:'Defina percentuais e prazos com clareza. A multa não pode superar a obrigação principal (art. 412 do CC).'},
m3:{i:'💰',t:'Sinal ou arras',p:'O pagamento do sinal ou das arras deve ser formalizado com clareza, indicando o valor, a forma de pagamento e as consequências da desistência.',l:['Arras confirmatórias: quem desiste perde o sinal (comprador) ou devolve em dobro (vendedor), podendo a parte inocente pedir indenização','Arras penitenciais: só existem se o contrato previr direito de arrependimento; a perda ou devolução em dobro é a única consequência'],d:'Escreva qual modalidade foi escolhida. Veja os arts. 417 a 420 do Código Civil.'},
m4:{i:'📊',t:'Riscos econômicos',p:'Antes de fechar o negócio, analise todos os custos envolvidos além do preço.',l:['Impostos (ex.: ITBI)','Taxas','Escritura','Registro','Outros custos adicionais (certidões, corretagem)'],d:'Consulte o cartório e a prefeitura para saber os valores atualizados de cada item.'},
m5:{i:'🌳',t:'Questões ambientais',p:'Verifique se o imóvel tem pendências ambientais, áreas de preservação ou restrições de uso. Isso evita prejuízos e responsabilidades futuras.',l:['Áreas de preservação permanente (APP) e reserva legal','Restrições de zoneamento e do Plano Diretor','Licenças e possíveis passivos ambientais','Cadastro Ambiental Rural (CAR), em imóveis rurais'],d:'A obrigação ambiental acompanha o imóvel: o novo proprietário pode responder por danos anteriores (Súmula 623 do STJ).'}};
const A=[['a1','Identificação','completa do comprador e vendedor'],['a2','Descrição','precisa do imóvel (endereço, matrícula, área etc.)'],['a3','Valor','da negociação'],['a4','Forma e prazo','de pagamento'],['a5','Data','de entrega/posse'],['a6','Responsabilidade','por impostos, taxas e despesas'],['a7','Multas','e consequências do descumprimento'],['a8','Condições','para rescisão'],['a9','Assinatura','das partes e testemunhas, quando cabível']];
const M=[['m1','1','Cláusulas essenciais','O contrato deve conter, de forma clara:',['Identificação das partes','Identificação do imóvel','Preço do imóvel','Forma de pagamento','Prazos de quitação e entrega']],['m2','2','Multas e inadimplemento','Preveja penalidades em caso de descumprimento:',['Juros','Multa','Rescisão contratual']],['m3','3','Sinal ou arras','Formalize o sinal com clareza, indicando:',['O valor','A forma de pagamento','Consequências da desistência']],['m4','4','Riscos econômicos','Antes de fechar, analise todos os custos:',['Impostos (ex.: ITBI)','Taxas','Escritura','Registro','Outros custos']],['m5','5','Questões ambientais','Verifique pendências ambientais, áreas de preservação ou restrições de uso. Isso evita prejuízos e responsabilidades futuras.',[]]];
/* ==========================================================
   IMAGENS: coloque aqui o caminho dos seus arquivos.
   - Deixe '' (vazio) para manter o desenho provisório.
   - Sugestão: crie uma pasta "img" ao lado deste arquivo HTML.
   ========================================================== */
const IMG={
  // LOGO da UCS Farroupilha (painel central da página 1).
  // PNG ou SVG com fundo transparente, versão BRANCA (o fundo é degradê azul/rosa).
  logo:'',   // ex.: 'img/logo-ucs-branca.png'

  // CAPA (painel da direita, página 1).
  // foto1 = foto de cima (prédio). JPG, ~1200px de largura, até ~300 KB.
  foto1:'',  // ex.: 'img/predio.jpg'
  // foto2 = foto de fundo do título (entrada). Recebe camada escura para o texto ficar legível.
  foto2:'',  // ex.: 'img/entrada.jpg'

  // ÍCONES dos 9 itens de "O que não pode faltar?" (página 1). PNG ou SVG quadrado, fundo transparente.
  // a1 Identificação | a2 Descrição do imóvel | a3 Valor | a4 Forma e prazo | a5 Data de entrega/posse
  // a6 Impostos e despesas | a7 Multas | a8 Rescisão | a9 Assinatura
  icones:{a1:'',a2:'',a3:'',a4:'',a5:'',a6:'',a7:'',a8:'',a9:''},  // ex.: a1:'img/icone-identificacao.svg'

  // ILUSTRAÇÕES dos 5 módulos (página 2), no canto inferior direito de cada cartão. PNG ou SVG, fundo transparente.
  // m1 Cláusulas essenciais | m2 Multas | m3 Sinal ou arras | m4 Riscos econômicos | m5 Questões ambientais
  modulos:{m1:'',m2:'',m3:'',m4:'',m5:''}  // ex.: m1:'img/modulo-1.png'
};
const $=s=>document.querySelector(s),ic=k=>IMG.icones[k]?`<img src="${IMG.icones[k]}" alt="">`:D[k].i;
$('#p1').innerHTML='<div class="c1"><div class="pill">O QUE NÃO PODE FALTAR?</div><div class="g9">'+A.map(a=>`<button class="it" data-k="${a[0]}"><i>${ic(a[0])}</i><span><b>${a[1]}</b> ${a[2]}</span></button>`).join('')+'</div></div><div class="c2">'+(IMG.logo?`<img class="logoimg" src="${IMG.logo}" alt="UCS Farroupilha">`:'<div class="logo"><b><span>✱</span>UCS</b><small>FARROUPILHA</small></div>')+'</div><div class="c3"><em>GUIA</em><span><em class="hl">COMPLETO</em><em>DE UM CONTRATO DE</em></span><strong>COMPRA E VENDA<br>DE IMÓVEL</strong></div>';
$('#p2').innerHTML=M.map(m=>`<button class="m m${m[1]}${IMG.modulos[m[0]]?' has':''}" data-k="${m[0]}"><h3><b>${m[1]}</b>${m[2]}</h3><p>${m[3]}</p>${m[4].length?'<ul>'+m[4].map(x=>`<li>${x}</li>`).join('')+'</ul>':''}${IMG.modulos[m[0]]?`<img src="${IMG.modulos[m[0]]}" alt="">`:''}</button>`).join('')+'<div class="end"><p><b>O contrato é a base dessa negociação</b> e garante os direitos e deveres de ambas as partes.</p><p>Com atenção aos detalhes, você protege seu investimento e evita problemas no futuro.</p></div>';
const c3=$('#p1 .c3');
if(IMG.foto2)c3.style.background=`linear-gradient(rgba(10,20,80,.5),rgba(10,20,80,.88)),url('${IMG.foto2}') center/cover`;
if(IMG.foto1)c3.insertAdjacentHTML('afterbegin',`<div class="ph" style="background:url('${IMG.foto1}') center/cover"></div>`);
document.querySelectorAll('.pg [data-k]').forEach(e=>e.tabIndex=-1);
const ov=$('#ov'),st=$('#st'),sh=$('#sh'),pgs=[...document.querySelectorAll('.pg')];let cur=0;
function open(i){cur=(i+pgs.length)%pgs.length;const c=pgs[cur].querySelector('.fit').cloneNode(true);c.querySelectorAll('[data-k]').forEach(e=>e.tabIndex=0);st.replaceChildren(c);sh.hidden=true;ov.hidden=false;document.body.style.overflow='hidden';$('#cl').focus()}
function close(){ov.hidden=true;document.body.style.overflow='';pgs[cur].focus()}
function info(k){const d=D[k];sh.innerHTML=`<h2><span>${d.i} ${d.t}</span><button id="x" aria-label="Fechar informação">✕</button></h2><p>${d.p}</p><ul>${d.l.map(x=>`<li>${x}</li>`).join('')}</ul><div class="tip"><b>Dica:</b> ${d.d}</div>`;sh.hidden=false;$('#x').onclick=()=>{sh.hidden=true};$('#x').focus()}
pgs.forEach((p,i)=>{p.onclick=()=>open(i);p.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open(i)}}});
st.onclick=e=>{const b=e.target.closest('[data-k]');if(b)info(b.dataset.k);else sh.hidden=true};
$('#cl').onclick=close;$('#pv').onclick=()=>open(cur-1);$('#nx').onclick=()=>open(cur+1);
document.onkeydown=e=>{if(ov.hidden)return;if(e.key==='Escape')sh.hidden?close():sh.hidden=true;if(e.key==='ArrowRight')open(cur+1);if(e.key==='ArrowLeft')open(cur-1)};
</script>
</body>
</html>
